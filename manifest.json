{
  "manifest_version": 3,
  "name": "Mi Extensión Chrome",
  "version": "1.0.0",
  "description": "Plantilla base moderna para desarrollar extensiones de Google Chrome (Manifest V3)",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Abrir Mi Extensión",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "contextMenus"
  ],
  "options_page": "options.html",
  "browser_specific_settings": {
    "gecko": {
      "id": "mi-extension-prueba@local.dev",
      "strict_min_version": "109.0"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
