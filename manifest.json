{
  "manifest_version": 3,
  "name": "Mi Extensión Chrome",
  "version": "1.0.0",
  "description": "Plantilla base moderna para desarrollar extensiones de Google Chrome (Manifest V3)",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Abrir Mi Extensión",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ]
}
